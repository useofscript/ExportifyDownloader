# Exportify YouTube Downloader - Environment Variables
# Copy this file to .env and customize values

# Output directory for downloaded music
EXPORTIFY_OUTPUT_DIR="~/Music"

# Number of parallel downloads (default: 3)
EXPORTIFY_PARALLEL=3

# Skip existing files (true/false)
EXPORTIFY_SKIP_EXISTING=true

# Create LRC lyrics files (true/false)
EXPORTIFY_CREATE_LRC=true

# Maximum album art size in pixels (max 1200)
EXPORTIFY_ALBUM_ART_SIZE=1200

# Verbose output (true/false)
EXPORTIFY_VERBOSE=false

# Download timeout in seconds
EXPORTIFY_TIMEOUT=300

# Maximum retry attempts
EXPORTIFY_RETRIES=3

